[
  { 
    "type": "heading", 
    "defaultValue": "xDrip Pebble Watchface" 
  }, 
  { 
    "type": "text", 
    "defaultValue": "Configure your watch face here" 
  },
  {
    "type": "toggle",
    "messageKey": "displaysecs",
    "label": "Display Seconds in Time",
    "defaultValue": false
  },
  {
    "type": "toggle",
    "messageKey": "viberepeat",
    "label": "Repeat Alert vibrations every 15 minutes",
    "defaultValue": true
  },
  {
    "type": "toggle",
    "messageKey": "novibe",
    "label": "Watch will not make any vibrations",
    "defaultValue": false
  },
  {
    "type": "toggle",
    "messageKey": "lightoncharge",
    "label": "Backlight on when watch is charging",
    "defaultValue": false
  },
  {
    "type": "toggle",
    "messageKey": "monochrome",
    "label": "Same background colour top and bottom",
    "defaultValue": false
  },
  {
    "type": "toggle",
    "messageKey": "boldtimeago",
    "label": "Make the Time Ago reading bold",
    "defaultValue": false
  },
  {
    "type": "color",
    "messageKey": "foreground",
    "defaultValue": "ffffff",
    "label": "Foreground Color",
    "capabilities": ["COLOR"],
    "sunlight": false
  },
  {
    "type": "color",
    "messageKey": "background",
    "defaultValue": "0000aa",
    "label": "Background Color",
    "capabilities": ["COLOR"],
    "sunlight": false
  },
  {
      "type": "slider",
      "messageKey": "messagetimeout",
      "defaultValue": 5,
      "label": "Show message for # seconds",
      "min": 5,
      "max": 60,
      "step": 5
  },
  {
      "type": "toggle",
      "messageKey": "show_delta",
      "defaultValue": true,
      "label": "Show delta value",
      "description": "Show the delta between in the top-left-bottom part"
  },
  {
      "type": "toggle",
      "messageKey": "show_unit",
      "defaultValue": false,
      "label": "Show delta unit",
      "description": "Show the unit of the delta value (mmol/L or mg/dL)"
  },
  {
      "type": "toggle",
      "messageKey": "show_slope",
      "defaultValue": true,
      "label": "Show the delta slope arrow",
      "description": "Show the slope arrow in the right top, errors will always be shown"
  },
  {
      "type": "toggle",
      "messageKey": "show_trend",
      "defaultValue": true,
      "label": "Show trend graph"
